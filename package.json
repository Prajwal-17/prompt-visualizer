{
  "name": "system-prompts-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "generate": "tsx scripts/generate-prompts.ts",
    "predev": "pnpm generate",
    "build": "pnpm generate && next build",
    "build:pages": "DEPLOY_TARGET=pages pnpm build",
    "build:workers": "XDG_CONFIG_HOME=.cache/config WRANGLER_LOG_PATH=.cache/wrangler WRANGLER_SEND_METRICS=false opennextjs-cloudflare build --config wrangler.workers.jsonc",
    "preview:workers": "XDG_CONFIG_HOME=.cache/config WRANGLER_LOG_PATH=.cache/wrangler WRANGLER_SEND_METRICS=false opennextjs-cloudflare preview --config wrangler.workers.jsonc",
    "preview:pages": "XDG_CONFIG_HOME=.cache/config WRANGLER_LOG_PATH=.cache/wrangler WRANGLER_SEND_METRICS=false wrangler pages dev out",
    "deploy:workers": "pnpm build:workers && opennextjs-cloudflare deploy --config wrangler.workers.jsonc",
    "deploy:pages": "pnpm build:pages && wrangler pages deploy out --project-name=system-prompts-pages",
    "start": "next start --hostname 0.0.0.0",
    "lint": "pnpm lint:ox && pnpm lint:next",
    "lint:ox": "oxlint app components lib scripts tests *.ts *.mjs --deny-warnings",
    "lint:next": "eslint app components lib scripts tests next.config.ts",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.build.json",
    "test": "tsx --test tests/content.test.ts",
    "test:e2e": "playwright test",
    "sync:prompts": "bash scripts/sync-prompts.sh",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "gpt-tokenizer": "4.0.0",
    "oxlint": "1.87.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.19.0"
}
